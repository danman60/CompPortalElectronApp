@@ -0,0 +1,505 @@
+#!/usr/bin/env node
+/**
+ * Durable Media Completion — proof harness (F1 + F2)
+ *
+ * Mirrors the real-module esbuild style: the THREE target services
+ *   - src/main/services/upload.ts
+ *   - src/main/services/state.ts
+ *   - src/main/services/mediaReconciler.ts
+ * are esbuild-bundled together with their real transitive deps
+ * (jobQueue, importManifest, utils, shared/types). Only the OUTER
+ * boundary is shimmed:
+ *   - electron            → pure JS stub (app.getPath → tmp)
+ *   - ../logger           → silent logger
+ *   - ../ipcUtil          → no-op sendToRenderer
+ *   - ./recording         → no-op broadcasts (heavy obs/ffmpeg/overlay tree)
+ *   - ./ffmpeg            → no-op thumbnail generator
+ *   - ./photos            → isImportRunning=false
+ *   - ./pipelineHealth    → no-op
+ *   - ./schedule          → fixed test connection pointing at the mock server
+ *   - ./settings          → minimal settings object
+ *   - ./dayChecklist      → no-op
+ * No business logic is mocked. The decisive verdict is read from the REAL
+ * compsync-state.json that the REAL state.ts writes, and from the actual
+ * HTTP request bodies captured by a local mock /api/plugin/complete server.
+ *
+ *   (i)  F1: state-reload between video R2 PUT and terminal complete.
+ *        UNPATCHED  → terminal payload video files empty/photo-only.
+ *        PATCHED    → terminal payload still carries performance+judge1-3.
+ *
+ *   (ii) F2: "video in R2, terminal never fired" + app restart.
+ *        UNPATCHED  → routine stays unfinalized forever (no re-fire).
+ *        PATCHED    → boot/sweep re-fires from durable state, server 2xx
+ *                     clears marker, no double-publish; marker persists
+ *                     across the simulated restart until success.
+ *
+ * Same fixture, opposite outcomes, primary-source verdict.
+ *
+ * Run:  node tests/durable-media-completion/harness.mjs
+ */
+
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import http from 'node:http'
+import crypto from 'node:crypto'
+import { once } from 'node:events'
+import { fileURLToPath } from 'node:url'
+import { build } from 'esbuild'
+
+const __filename = fileURLToPath(import.meta.url)
+const __dirname = path.dirname(__filename)
+const REPO_ROOT = path.resolve(__dirname, '..', '..')
+const SRC = path.join(REPO_ROOT, 'src')
+
+// ── Test harness primitives ───────────────────────────────────────────────
+const results = []
+function record(name, ok, detail = '') {
+  results.push({ name, ok, detail })
+  console.log(`  [${ok ? 'PASS' : 'FAIL'}] ${name}${detail ? ' — ' + detail : ''}`)
+}
+function assertEq(name, actual, expected) {
+  const ok = JSON.stringify(actual) === JSON.stringify(expected)
+  record(name, ok, ok ? `= ${JSON.stringify(actual)}` : `expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`)
+  return ok
+}
+function assertTrue(name, cond, detail = '') {
+  record(name, !!cond, detail)
+  return !!cond
+}
+
+// ── Mock CompPortal /api/plugin/complete server ───────────────────────────
+//
+// Captures every terminal complete body. Programmable response: returns a
+// status, and optionally a 5xx to simulate "never finalized".
+const capturedCompletes = []
+let serverMode = 'ok-published' // 'ok-published' | 'fail-500' | 'ok-nostatus'
+
+const server = http.createServer((req, res) => {
+  if (req.method === 'POST' && req.url === '/api/plugin/complete') {
+    let raw = ''
+    req.on('data', (c) => { raw += c })
+    req.on('end', () => {
+      let body = null
+      try { body = JSON.parse(raw) } catch {}
+      capturedCompletes.push({ at: Date.now(), body })
+      if (serverMode === 'fail-500') {
+        res.writeHead(500, { 'Content-Type': 'text/plain' })
+        res.end('simulated CompPortal outage')
+        return
+      }
+      res.writeHead(200, { 'Content-Type': 'application/json' })
+      if (serverMode === 'ok-nostatus') {
+        res.end(JSON.stringify({ packageId: 'pkg-' + crypto.randomUUID() }))
+      } else {
+        res.end(JSON.stringify({ packageId: 'pkg-' + crypto.randomUUID(), status: 'published' }))
+      }
+    })
+    return
+  }
+  res.writeHead(404); res.end()
+})
+
+// ── esbuild: bundle real modules, shim only the outer boundary ────────────
