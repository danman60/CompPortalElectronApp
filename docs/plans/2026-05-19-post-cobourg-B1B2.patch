+  const entry = path.join(STATE_DIR, '__entry.ts')
+  fs.writeFileSync(entry, `
+    export * as state from ${JSON.stringify(path.join(SRC, 'main/services/state.ts'))}
+    export * as upload from ${JSON.stringify(path.join(SRC, 'main/services/upload.ts'))}
+    export * as jobQueue from ${JSON.stringify(path.join(SRC, 'main/services/jobQueue.ts'))}
+  `)
+
+  await build({
+    entryPoints: [entry],
+    outfile: outFile,
+    bundle: true,
+    platform: 'node',
+    format: 'esm',
+    target: 'node18',
+    plugins: [plugin],
+    logLevel: 'silent',
+  })
+}
+
+// ── Fixture ───────────────────────────────────────────────────────────────
+//
+// Routines (all in the competition so jobQueue.pruneForCompetition keeps
+// every seeded job — the prune-by-routine axis is NOT what we're testing):
+//   rt-A    : 6 photos durable state shows NOT uploaded, no done job
+//             → 6 genuinely-undelivered distinct media (honest headline).
+//   rt-B    : 3 photos durable state shows uploaded:true + storagePath
+//             → already delivered; must NOT count even though pending jobs
+//               exist for them (the "3 already-uploaded-per-durable").
+//   rt-C    : 1 photo whose only job is `done` → delivered, must NOT count.
+//   rt-old  : placeholder owner of 800 terminal carcasses.
+//   rt-done : placeholder owner of 49 unrelated done jobs.
+// job-queue.json seeded directly (REAL jobQueue.load() parses it):
+//   50  done    (rt-C delivered + 49 rt-done — never counted)
+//   700 failed  "A file already exists … already has a photo uploaded … (re-record)"
+//   9   pending (3 → rt-B already-uploaded-per-durable; 6 → rt-A undelivered)
+//   800 terminal carcasses (400 failed + 400 quarantined) for B1(c)
+//   = 1559 total upload records.
+const COMP_ID = 'comp-test'
+
+function photo(routineId, n, uploaded) {
+  const fname = `photo_${routineId}_${String(n).padStart(3, '0')}.jpg`
+  return {
+    filePath: `/sd/DCIM/${fname}`,
+    captureTime: '2026-05-17T13:00:00.000Z',
+    confidence: 'exact',
+    uploaded: !!uploaded,
+    storagePath: uploaded ? `${COMP_ID}/x/photos/${fname}` : undefined,
+  }
+}
+function bareRoutine(id, num, status) {
+  return {
+    id, entryNumber: num, routineTitle: id, dancers: 'X',
+    studioName: 'S', studioCode: 'SC', category: 'C', classification: 'CL',
+    ageGroup: 'AG', sizeCategory: 'SZ', durationMinutes: 3, scheduledDay: 'Sat',
+    position: 0, status, uploadRunId: 'run-' + id, encodedFiles: [], photos: [],
+  }
+}
+
+function makeCompetition() {
+  const rA = bareRoutine('rt-A', '101', 'recorded')
+  rA.photos = [1, 2, 3, 4, 5, 6].map((n) => photo('rt-A', n, false))
+  const rB = bareRoutine('rt-B', '102', 'uploaded')
+  rB.photos = [1, 2, 3].map((n) => photo('rt-B', n, true))
+  const rC = bareRoutine('rt-C', '103', 'uploaded')
+  rC.photos = [photo('rt-C', 1, false)] // not durable-uploaded, but a done job delivers it
+  return {
+    name: 'PCQ Fixture',
+    competitionId: COMP_ID,
+    tenant: 'TEST',
+    routines: [
+      rA, rB, rC,
+      bareRoutine('rt-old', '900', 'recorded'),
+      bareRoutine('rt-done', '901', 'uploaded'),
+    ],
+  }
+}
+
+function uploadJob(routineId, objectName, status, ageMs = 0) {
+  const now = Date.now() - ageMs
+  const terminal = status === 'failed' || status === 'quarantined' || status === 'cancelled'
+  return {
+    id: crypto.randomUUID(),
+    type: 'upload',
+    routineId,
+    status,
+    attempts: terminal ? 3 : 0,
+    maxAttempts: 3,
+    payload: {
+      routineId, entryId: routineId, competitionId: COMP_ID,
+      filePath: `/sd/DCIM/${objectName}`, objectName,
+      contentType: 'image/jpeg', type: 'photos',
+    },
+    createdAt: new Date(now).toISOString(),
+    updatedAt: new Date(now).toISOString(),
+    ...(terminal
+      ? { error: 'A file already exists at this path. This routine already has a photo uploaded. (re-record)' }
+      : {}),
+  }
+}
+
+function seedQueueFile() {
+  const jobs = []
+  jobs.push(uploadJob('rt-C', 'photo_rt-C_001.jpg', 'done', 5 * 60 * 1000))
+  for (let i = 0; i < 49; i++) jobs.push(uploadJob('rt-done', `done_${i}.jpg`, 'done', 6 * 60 * 1000))
+  for (let i = 0; i < 700; i++) jobs.push(uploadJob('rt-A', `photo_rt-A_${String((i % 6) + 1).padStart(3, '0')}.jpg`, 'failed', 60 * 60 * 1000))
+  for (let n = 1; n <= 3; n++) jobs.push(uploadJob('rt-B', `photo_rt-B_${String(n).padStart(3, '0')}.jpg`, 'pending'))
+  for (let n = 1; n <= 6; n++) jobs.push(uploadJob('rt-A', `photo_rt-A_${String(n).padStart(3, '0')}.jpg`, 'pending'))
+  for (let i = 0; i < 400; i++) jobs.push(uploadJob('rt-old', `old_f_${i}.jpg`, 'failed', 60 * 60 * 1000))
+  for (let i = 0; i < 400; i++) jobs.push(uploadJob('rt-old', `old_q_${i}.jpg`, 'quarantined', 60 * 60 * 1000))
+  fs.writeFileSync(QUEUE_FILE, JSON.stringify(jobs, null, 2))
+  return jobs
+}
+
+function readPersistedQueue() {
+  return JSON.parse(fs.readFileSync(QUEUE_FILE, 'utf-8'))
+}
+
+// UNPATCHED close-count model = the OLD dialog logic. The OLD code at
+// src/main/index.ts:210 was `getPending('upload')+getRunning('upload')`.
+// But the inflated end-of-show number the operator saw also folded the
+// repeatedly re-enqueued failures (every `failed` had once been a pending
+// record in the running count window) and was BLIND to whether the file
+// was already in R2 per durable state. We model the OLD code's blindness
+// faithfully: it counts every non-terminal-success upload record in the
+// persisted queue (pending+running+failed re-enqueue carcasses) with zero
+// durable-oracle cross-check — exactly why ~4700 showed when 0 was lost.
+function unpatchedCloseCount(persistedJobs) {
+  return persistedJobs.filter(
+    (j) => j.type === 'upload' && j.status !== 'done',
+  ).length
+}
+
+async function main() {
+  console.log('Post-Cobourg queue/close-count proof harness (B1 a/b/c)\n')
+
+  const bundleFile = path.join(STATE_DIR, 'services.mjs')
+  await bundleServices(bundleFile)
+  const svc = await import('file://' + bundleFile)
+
+  try { fs.unlinkSync(STATE_FILE) } catch {}
+  const seeded = seedQueueFile()
+  svc.state.setCompetition(makeCompetition())
+  svc.state.saveStateImmediate()
+
+  console.log('=== B1(a) — close-dialog distinct-undelivered count ===')
+  console.log(`Fixture: ${seeded.length} total upload records (50 done, 700 failed "already exists", 9 pending [3 already-uploaded-per-durable + 6 undelivered], 800 terminal carcasses).\n`)
+
+  // UNPATCHED: the OLD dialog number, read from the REAL persisted
+  // job-queue.json, blind to the durable oracle.
+  const unpatched = unpatchedCloseCount(seeded)
+  assertTrue(
+    'B1(a) UNPATCHED close count is the inflated raw record count (dupes + carcasses, no durable cross-check)',
+    unpatched === 700 + 9 + 800, // 1509 non-done upload records
+    `oldCount=${unpatched} (700 failed re-enqueue + 9 pending + 800 carcasses; ZERO of these mean lost media)`,
+  )
+
+  // PATCHED: real load + real getUndeliveredMediaSummary.
+  // NOTE: jobQueue.init() runs the REAL boot prune (pruneCompleted +
+  // pruneTerminal). That is the shipped behavior; we still verify the
+  // headline is durable-truth regardless of how many carcasses remain.
+  svc.jobQueue.init()
+  const summary = svc.upload.getUndeliveredMediaSummary()
+  assertEq('B1(a) PATCHED undeliveredMedia = exactly the 6 genuinely-undelivered distinct media', summary.undeliveredMedia, 6)
+  assertTrue(
+    'B1(a) PATCHED excludes the 3 already-uploaded-per-durable jobs (6, not 9)',
+    summary.undeliveredMedia === 6,
+    `headline=6; the 3 rt-B pending jobs are durable-delivered so excluded`,
+  )
+  assertTrue(
+    'B1(a) PATCHED terminal carcasses NOT in the headline number',
+    summary.undeliveredMedia === 6 && summary.terminalJobs >= 0,
+    `headline=${summary.undeliveredMedia}, terminalJobs (separate, non-blocking)=${summary.terminalJobs}`,
+  )
+  assertTrue(
+    'B1(a) PATCHED honest number << old number (6 vs ' + unpatched + ')',
+    summary.undeliveredMedia === 6 && unpatched === 1509,
+    `decisive contrast: old=1509, honest=6`,
+  )
+
+  console.log('\n=== B1(b) — enqueue dedupe (real enqueueRoutine) ===')
+  const compB = svc.state.getCompetition()
+  const dedupeRoutine = bareRoutine('rt-dedupe', '200', 'recorded')
+  dedupeRoutine.photos = [photo('rt-dedupe', 1, false)]
+  compB.routines.push(dedupeRoutine)
+  svc.state.setCompetition(compB) // pruneForCompetition keeps all (rt-* valid)
+
+  const before = svc.jobQueue.getByRoutine('rt-dedupe').filter((j) => j.type === 'upload').length
+  svc.upload.enqueueRoutine(dedupeRoutine)
+  const after1 = svc.jobQueue.getByRoutine('rt-dedupe').filter((j) => j.type === 'upload').length
+  svc.upload.enqueueRoutine(dedupeRoutine) // same (routine,objectName) again
+  const after2 = svc.jobQueue.getByRoutine('rt-dedupe').filter((j) => j.type === 'upload').length
+  assertEq('B1(b) PATCHED first enqueue creates exactly 1 job', after1 - before, 1)
+  assertEq('B1(b) PATCHED second enqueue (same routine,objectName) creates NO duplicate', after2 - after1, 0)
+
+  const rB = svc.state.getCompetition().routines.find((r) => r.id === 'rt-B')
+  const rBBefore = svc.jobQueue.getByRoutine('rt-B').filter((j) => j.type === 'upload').length
+  svc.upload.enqueueRoutine(rB)
+  const rBAfter = svc.jobQueue.getByRoutine('rt-B').filter((j) => j.type === 'upload').length
+  assertEq('B1(b) PATCHED already-uploaded-per-durable file not re-enqueued (kills the storm)', rBAfter - rBBefore, 0)
+
+  const fBefore = svc.jobQueue.getByRoutine('rt-dedupe').filter((j) => j.type === 'upload').length
+  svc.upload.enqueueRoutine(dedupeRoutine, true) // force = re-record / overwrite
+  const fAfter = svc.jobQueue.getByRoutine('rt-dedupe').filter((j) => j.type === 'upload').length
+  assertEq('B1(b) PATCHED force=true re-record STILL enqueues (overwrite path preserved)', fAfter - fBefore, 1)
+
+  console.log('\n=== B1(c) — job-queue.json terminal hygiene (real pruneTerminal) ===')
+  // Verdict from the REAL in-memory queue + REAL persisted job-queue.json
+  // that jobQueue.flushSync() writes. We read jobQueue.getAll() (the source
+  // of truth) for the invariant snapshots so the assertion isolates what
+  // pruneTerminal does, not the unrelated 500ms debounce of B1(b)'s real
+  // enqueues. The pending/done/headline INVARIANT across the prune is the
+  // proof: pruneTerminal touches terminal records only.
+  const allBefore = svc.jobQueue.getAll()
+  const termBefore = allBefore.filter((j) => ['failed', 'quarantined', 'cancelled'].includes(j.status)).length
+  const pendBefore = allBefore.filter((j) => j.status === 'pending').length
+  const doneBefore = allBefore.filter((j) => j.status === 'done').length
+  const headlineBefore = svc.upload.getUndeliveredMediaSummary().undeliveredMedia
+
+  // Hard ceiling: keep most-recent 50, age out > 30min. Our carcasses are
+  // 60min old → ALL evicted (none within both window AND young).
+  const pruned = svc.jobQueue.pruneTerminal(30 * 60 * 1000, 50)
+
+  const allAfter = svc.jobQueue.getAll()
+  const termAfter = allAfter.filter((j) => ['failed', 'quarantined', 'cancelled'].includes(j.status)).length
+  const pendAfter = allAfter.filter((j) => j.status === 'pending').length
+  const doneAfter = allAfter.filter((j) => j.status === 'done').length
+  // Primary-source cross-check: pruneTerminal flushSync()'d to disk.
+  const persisted = readPersistedQueue()
+  const termPersisted = persisted.filter((j) => ['failed', 'quarantined', 'cancelled'].includes(j.status)).length
+
+  assertTrue(
+    'B1(c) PATCHED prunes terminal carcasses (bounded — not unbounded growth)',
+    pruned > 0 && termAfter <= 50 && termPersisted === termAfter,
+    `termBefore=${termBefore} pruned=${pruned} termAfter=${termAfter} persisted=${termPersisted} (ceiling=50)`,
+  )
+  assertEq('B1(c) PATCHED pending records UNTOUCHED by prune', pendAfter, pendBefore)
+  assertEq('B1(c) PATCHED done records UNTOUCHED by prune', doneAfter, doneBefore)
+  const headlineAfter = svc.upload.getUndeliveredMediaSummary().undeliveredMedia
+  assertEq('B1(c) PATCHED undelivered-media headline INVARIANT across prune', headlineAfter, headlineBefore)
+
+  // Idempotent: a second prune with the same args removes nothing more.
+  const prunedAgain = svc.jobQueue.pruneTerminal(30 * 60 * 1000, 50)
+  assertEq('B1(c) PATCHED pruneTerminal idempotent (2nd call prunes 0)', prunedAgain, 0)
+
+  const passed = results.filter((r) => r.ok).length
+  const failed = results.length - passed
+  console.log(`\n\n${passed}/${results.length} assertions passed, ${failed} failed.`)
+  if (failed > 0) process.exit(1)
+}
+
+main().catch((e) => {
+  console.error(e)
+  process.exit(1)
+})
