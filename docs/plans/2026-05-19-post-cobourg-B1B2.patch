+          compsync: { shareCode: 'TEST' },
+        }
+      }
+    `,
+    DAYCHECKLIST: `export function maybeFireEndOfDay() {} export function maybeFireStartOfDay() {}`,
+    IMPORTMANIFEST: `
+      export async function markUploaded() {}
+      export async function loadManifest() { return {} }
+    `,
+  }
+
+  const plugin = {
+    name: 'pcq-stubs',
+    setup(b) {
+      const byBase = {
+        electron: 'electron',
+        logger: 'LOGGER',
+        events: 'EVENTS',
+        ipcUtil: 'IPCUTIL',
+        recording: 'RECORDING',
+        ffmpeg: 'FFMPEG',
+        photos: 'PHOTOS',
+        pipelineHealth: 'PIPELINEHEALTH',
+        schedule: 'SCHEDULE',
+        settings: 'SETTINGS',
+        dayChecklist: 'DAYCHECKLIST',
+        importManifest: 'IMPORTMANIFEST',
+      }
+      b.onResolve({ filter: /.*/ }, (args) => {
