  * Retry uploading any routines stuck at 'encoded' that were skipped due to missing connection.
  * Yields to the event loop every BATCH_SIZE routines to prevent AppHangB1 on startup
@@ -1865,3 +2208,114 @@ export function getQueueState(): { routineId: string; status: string }[] {
     .filter(j => j.type === 'upload')
     .map(j => ({ routineId: j.routineId, status: j.status }))
 }
+
+// ── B1(a): operator-facing "media still genuinely needing delivery" ───────
+//
+// The close dialog previously reported raw `getPending('upload') +
+// getRunning('upload')` job-record count. Post-Cobourg that hit ~4700 at
+// end-of-show — inflated by (1) the same already-uploaded file re-enqueued
+// repeatedly across the day (each landing as a `failed "already exists"`
+// record), (2) terminal failed/quarantined carcasses never pruned, (3)
+// order-A photo-tier intentionally stacking "remaining" photos pending. DB
+// cross-check proved zero media lost (544/545 published).
+//
+// The honest number is: distinct (routineId, objectName) media whose
+// DURABLE state (F1 encodedFiles[].uploaded/storagePath +
+// photos[].uploaded/storagePath, the B2 oracle) shows NOT uploaded AND that
+// is not already covered by a `done` upload job. Routines whose video bytes
+// are in R2 but whose terminal /complete hasn't been acknowledged carry the
+// F2 `videoCompletePending` marker — those bytes are safe; they are reported
+// SEPARATELY as "awaiting finalize", not as undelivered media. Terminal
+// failed/quarantined/cancelled jobs are reported as a non-blocking aside.
+export interface UndeliveredMediaSummary {
+  /** Distinct (routine,file) media that durable state shows still needs
+   *  uploading. THIS is the operator-facing headline number. */
+  undeliveredMedia: number
+  /** Routines with video in R2 awaiting the terminal /complete re-fire (F2).
+   *  Bytes are safe — informational, not blocking. */
+  awaitingFinalize: number
+  /** Terminal job carcasses (failed/quarantined/cancelled). Not blocking;
+   *  shown as a separate "(N failed — not blocking)" line if non-zero. */
+  terminalJobs: number
+  /** Raw pending+running job-record count — kept for log parity / debugging
+   *  only. NEVER the operator-facing number. */
+  rawPendingRunningJobs: number
+}
+
+export function getUndeliveredMediaSummary(): UndeliveredMediaSummary {
+  const rawPendingRunningJobs =
+    jobQueue.getPending('upload').length + jobQueue.getRunning('upload').length
+  const terminalJobs =
+    jobQueue.getFailed('upload').length +
+    jobQueue.getQuarantined('upload').length +
+    jobQueue.getAll().filter((j) => j.type === 'upload' && j.status === 'cancelled').length
+
+  const comp = state.getCompetition()
+  if (!comp) {
+    return {
+      undeliveredMedia: 0,
+      awaitingFinalize: 0,
+      terminalJobs,
+      rawPendingRunningJobs,
+    }
+  }
+
+  // Distinct undelivered media keyed by `${routineId}::${objectName}` so the
+  // same file enqueued N times (the storm) counts ONCE, and only if durable
+  // state genuinely shows it not uploaded and no `done` job delivered it.
+  const undelivered = new Set<string>()
+  let awaitingFinalize = 0
+
+  for (const routine of comp.routines) {
+    if (routine.videoCompletePending === true) awaitingFinalize++
+
+    // Videos: a role is delivered iff durable encodedFile.uploaded &&
+    // storagePath, OR a done upload job exists for `<role>.mp4`.
+    for (const f of routine.encodedFiles || []) {
+      const objectName = `${f.role}.mp4`
+      const durableDelivered = f.uploaded === true && !!f.storagePath
+      if (durableDelivered) continue
+      if (jobQueue.hasActiveOrDeliveredUploadJob(routine.id, objectName)) {
+        // It's queued/running/done — already accounted as in-flight work.
+        // A `done` job means delivered; pending/running means it WILL be
+        // delivered and is a single distinct unit (count once below).
+        const arr = jobQueue
+          .getByRoutine(routine.id)
+          .filter(
+            (j) =>
+              j.type === 'upload' &&
+              (j.payload as Record<string, unknown>).objectName === objectName,
+          )
+        const anyDone = arr.some((j) => j.status === 'done')
+        if (anyDone) continue
+      }
+      undelivered.add(`${routine.id}::${objectName}`)
+    }
+
+    // Photos: delivered iff durable photo.uploaded && storagePath, OR a done
+    // upload job exists for that basename.
+    for (const p of routine.photos || []) {
+      if (p.confidence === 'unmatched') continue // never uploaded by design
+      const objectName = (p.filePath || '').split(/[\\/]/).pop() || ''
+      if (!objectName) continue
+      const durableDelivered = p.uploaded === true && !!p.storagePath
+      if (durableDelivered) continue
+      const arr = jobQueue
+        .getByRoutine(routine.id)
+        .filter(
+          (j) =>
+            j.type === 'upload' &&
+            (j.payload as Record<string, unknown>).objectName === objectName,
+        )
+      if (arr.some((j) => j.status === 'done')) continue
+      undelivered.add(`${routine.id}::${objectName}`)
+    }
+  }
+
+  return {
+    undeliveredMedia: undelivered.size,
+    awaitingFinalize,
+    terminalJobs,
+    rawPendingRunningJobs,
+  }
+}
