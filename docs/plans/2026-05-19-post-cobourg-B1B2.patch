+// ── B1(c): terminal-job hygiene ───────────────────────────────────────────
+//
+// Post-Cobourg incident (2026-05-17): job-queue.json grew to 967 records
+// (779 failed + 165 quarantined + 14 cancelled) because pruneCompleted only
+// ages out `done`. Terminal failed/quarantined/cancelled records accumulate
+// forever; nothing reads them after they reach a terminal state, yet the
+// close dialog counted raw pending+running and the count looked like ~4700
+// "outstanding uploads" at end-of-show. DB cross-check proved zero media
+// lost — these are job carcasses, not outstanding media.
+//
+// This bounds terminal failed/quarantined/cancelled records with a HARD
+// ceiling — a terminal job is kept ONLY if it is BOTH within the
+// most-recent-`keepMostRecent` window AND younger than `olderThanMs`.
+// The conjunction (not disjunction) is deliberate: the live incident hit
+// 967 carcasses *within a single show day* (all < 24h), so an age-only
+// retention never fired. The keep-recent ceiling caps job-queue.json even
+// mid-show; the age bound additionally evicts the survivors on later days.
+// pending/running/done are NEVER touched. Idempotent, crash-safe (flushSync).
+const TERMINAL_STATUSES: ReadonlySet<JobStatus> = new Set<JobStatus>([
+  'failed',
+  'quarantined',
+  'cancelled',
+])
+
+export function pruneTerminal(
+  olderThanMs: number,
+  keepMostRecent = 200,
+): number {
+  const cutoff = Date.now() - olderThanMs
+  const before = jobs.length
+
+  // Most-recent-N terminal jobs (by updatedAt desc). A terminal job survives
+  // ONLY if it is in this window AND still young. Everything else is a
+  // carcass and is pruned.
+  const terminal = jobs
+    .filter((j) => TERMINAL_STATUSES.has(j.status))
+    .sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime())
+  const keepIds = new Set<string>()
+  for (let i = 0; i < terminal.length && i < keepMostRecent; i++) {
+    const j = terminal[i]
+    const young = new Date(j.updatedAt).getTime() > cutoff
+    if (young) keepIds.add(j.id)
+  }
+
+  jobs = jobs.filter((j) => {
+    if (!TERMINAL_STATUSES.has(j.status)) return true // pending/running/done untouched
+    return keepIds.has(j.id)
+  })
+
+  const pruned = before - jobs.length
+  if (pruned > 0) {
+    rebuildRoutineIndex()
+    logger.app.info(
+      `Job queue: pruned ${pruned} terminal (failed/quarantined/cancelled) job carcass(es); ${jobs.length} jobs remain`,
+    )
+    flushSync()
+  }
+  return pruned
+}
+
+/**
+ * B1(b) dedupe oracle — does a non-terminal OR successfully-delivered upload
+ * job already exist for this (routineId, objectName)? Used by upload.ts
+ * enqueue sites to refuse creating a duplicate upload job for a file that is
+ * already queued, in flight, or already uploaded. Terminal
+ * failed/quarantined/cancelled jobs do NOT count (a genuine retry is allowed
+ * via the normal force/re-record path). `done` DOES count — the file is in
+ * R2; re-enqueuing it just produces the "already exists" failure storm.
+ */
+export function hasActiveOrDeliveredUploadJob(
+  routineId: string,
+  objectName: string,
+): boolean {
+  const arr = routineIndex.get(routineId)
+  if (!arr) return false
+  for (const j of arr) {
+    if (j.type !== 'upload') continue
+    if (j.status !== 'pending' && j.status !== 'running' && j.status !== 'done') continue
+    const on = (j.payload as Record<string, unknown>).objectName
+    if (typeof on === 'string' && on === objectName) return true
+  }
+  return false
+}
