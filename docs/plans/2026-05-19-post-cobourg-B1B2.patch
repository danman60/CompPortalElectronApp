+ *     (nothing to finalize on the video axis — never an empty re-publish).
+ *   - Skips routines already past the marker (cleared) — the marker is the
+ *     single source of truth; an already-published routine has no marker.
+ *   - On 2xx the response handler clears the marker (clearVideoComplete…).
+ *   - Per-routine in-process backoff prevents endpoint hammering.
+ *   - No connection / no uploadRunId → skip (cannot finalize safely).
+ *
+ * VISUAL-ONLY, NON-BLOCKING: never opens a modal, never gates recording,
+ * never emits audio. Returns a count for log + the audit-panel surface.
+ *
+ * Callable from boot recovery and the mediaReconciler sweep. Idempotent and
+ * safe to call repeatedly.
+ */
+export async function refireUnfinalizedCompletions(): Promise<{
+  scanned: number
+  refired: number
+  cleared: number
+  skipped: number
+  errors: number
+}> {
+  const out = { scanned: 0, refired: 0, cleared: 0, skipped: 0, errors: 0 }
+  const comp = state.getCompetition()
+  if (!comp) return out
+  if (!hasResolvedUploadConnection()) return out
+
+  const pending = comp.routines.filter((r) => r.videoCompletePending === true)
+  out.scanned = pending.length
+  if (pending.length === 0) return out
+
+  const conn = getConnection()
+
+  for (const routine of pending) {
+    // Idempotent guard: an already-finalized routine must never carry the
+    // marker, but double-check the marker is still set (it may have cleared
+    // mid-sweep via a concurrent terminal complete).
+    const fresh = state.getCompetition()?.routines.find((r) => r.id === routine.id)
+    if (!fresh || fresh.videoCompletePending !== true) { out.skipped++; continue }
+    if (refireIsBackedOff(routine.id)) { out.skipped++; continue }
+    if (!fresh.uploadRunId) {
+      logger.upload.warn(`F2 re-fire: routine ${routine.id.slice(0, 8)} has no uploadRunId — cannot finalize, skipping`)
+      out.skipped++
+      continue
+    }
+
+    // Rebuild payload from DURABLE state only.
+    const storagePaths: Record<string, string> = {}
+    for (const f of fresh.encodedFiles || []) {
+      if (f.uploaded && f.storagePath) storagePaths[f.role] = f.storagePath
+    }
+    const VIDEO_ROLES = ['performance', 'judge1', 'judge2', 'judge3', 'judge4']
+    const hasVideoRole = VIDEO_ROLES.some((r) => !!storagePaths[r])
+    if (!hasVideoRole) {
+      // Marker set but no durable video path — nothing to finalize on the
+      // video axis. Leave the marker (a later F1 write may fill it) but do
+      // NOT fire an empty/photo-only complete (that's the original bug).
+      logger.upload.warn(
+        `F2 re-fire: routine ${routine.id.slice(0, 8)} marked pending but no durable video storagePath — skipping (no empty re-publish)`,
+      )
+      out.skipped++
+      continue
+    }
+
+    const photoStoragePaths: string[] = []
+    const photoThumbnailStoragePaths: string[] = []
+    const photoCapturedAt: string[] = []
+    for (const p of fresh.photos || []) {
+      if (p.uploaded && p.storagePath) {
+        photoStoragePaths.push(p.storagePath)
+        photoThumbnailStoragePaths.push(p.thumbnailStoragePath || '')
+        photoCapturedAt.push(p.captureTime || '')
+      }
+    }
+    // Keyframes are local paths in state; their R2 keys live on the done
+    // upload jobs which are gone post-restart. Re-fire focuses on the video
+    // roles (the actual data-loss axis). Pass empty — CompPortal keeps any
+    // keyframes already persisted from a prior partial complete.
+    const videoKeyframeStoragePaths: string[] = []
+
+    try {
+      await callPluginComplete({
+        routineId: routine.id,
+        entryId: routine.id,
+        competitionId: conn.competitionId,
+        uploadRunId: fresh.uploadRunId,
+        storagePaths,
+        photoStoragePaths,
+        photoThumbnailStoragePaths,
+        photoCapturedAt,
+        videoKeyframeStoragePaths,
+      })
+      out.refired++
+      // callPluginComplete's response handler clears the durable marker on
+      // 2xx (carriedVideoRole path). Confirm + tally.
+      const after = state.getCompetition()?.routines.find((r) => r.id === routine.id)
+      if (after && after.videoCompletePending !== true) {
+        out.cleared++
+        refireBackoff.delete(routine.id)
+        state.updateRoutineStatus(routine.id, after.status === 'encoded' ? 'uploaded' : after.status, {})
+      }
+      logger.upload.info(`F2 re-fire: routine ${routine.id.slice(0, 8)} terminal complete re-sent from durable state`)
+    } catch (err) {
+      out.errors++
+      refireOnFailure(routine.id)
+      logger.upload.warn(
+        `F2 re-fire failed for routine ${routine.id.slice(0, 8)} (marker retained, will retry next sweep):`,
+        err instanceof Error ? err.message : err,
+      )
+    }
+  }
+
+  if (out.refired > 0 || out.cleared > 0) {
+    logger.upload.info(
+      `F2 re-fire sweep: scanned=${out.scanned} refired=${out.refired} cleared=${out.cleared} skipped=${out.skipped} errors=${out.errors}`,
+    )
+  }
+  return out
+}
+
+/** Count routines currently carrying the durable F2 needs-complete marker. */
+export function countUnfinalizedRoutines(): number {
+  const comp = state.getCompetition()
+  if (!comp) return 0
+  return comp.routines.filter((r) => r.videoCompletePending === true).length
+}
+
+/**
+ * Test-only seam (durable-media-completion proof harness). Exposes the
+ * internal F1 persist helper so the harness can drive the exact runtime
+ * behavior — persisting role storagePaths to durable state at R2-PUT time —
+ * without mocking any logic. NOT used in production code paths.
+ */
+export function __test_persistDurableStoragePaths(
+  routineId: string,
+  storagePaths: Record<string, string>,
+  photoStoragePaths: string[],
+  photoThumbnailStoragePaths: string[],
+): void {
+  persistDurableStoragePaths(routineId, storagePaths, photoStoragePaths, photoThumbnailStoragePaths)
+}
+
