+        apiBase: ${JSON.stringify('http://127.0.0.1:__PORT__')},
+        name: 'Test Comp', apiKey: 'csm_test'
+      }
+      export function getResolvedConnection() { return conn }
+      export function setResolvedConnectionForTest(c) { conn = c }
+      export function clearResolvedConnection() { conn = null }
+    `,
+    SETTINGS: `
+      export function getSettings() {
+        return {
+          fileNaming: { outputDirectory: ${JSON.stringify(OUT_DIR)} },
+          behavior: { autoUploadAfterEncoding: true, autoEncodeRecordings: false },
+          upload: { autoResumeOnBoot: true, reconcileCadenceMinutes: 0, reconcileSilent: true, incrementalPublish: false },
+          compsync: { shareCode: 'TEST' },
+        }
+      }
+    `,
+    DAYCHECKLIST: `export function maybeFireEndOfDay() {} export function maybeFireStartOfDay() {}`,
+    IMPORTMANIFEST: `
+      export async function markUploaded() {}
+      export async function loadManifest() { return {} }
+    `,
+  }
+
+  const plugin = {
+    name: 'dmc-stubs',
+    setup(b) {
+      // Key on the import specifier's basename so bare relative paths
+      // (./schedule, ../logger, ./services/recording) all match. Only the
+      // outer boundary is stubbed — upload/state/mediaReconciler stay real.
+      const byBase = {
+        electron: 'electron',
+        logger: 'LOGGER',
+        ipcUtil: 'IPCUTIL',
+        recording: 'RECORDING',
+        ffmpeg: 'FFMPEG',
+        photos: 'PHOTOS',
+        pipelineHealth: 'PIPELINEHEALTH',
+        schedule: 'SCHEDULE',
+        settings: 'SETTINGS',
+        dayChecklist: 'DAYCHECKLIST',
+        importManifest: 'IMPORTMANIFEST',
+      }
+      b.onResolve({ filter: /.*/ }, (args) => {
+        if (args.path === '__entry' || args.namespace === STUB_NS) return null
+        const base = args.path.replace(/\.[tj]s$/, '').split('/').pop()
+        const key = byBase[base]
+        if (key) return { path: key, namespace: STUB_NS }
+        return null
+      })
+      b.onLoad({ filter: /.*/, namespace: STUB_NS }, (args) => ({
+        contents: stubs[args.path].replace('__PORT__', String(MOCK_PORT)),
+        loader: 'js',
+      }))
+    },
+  }
+
+  // Single entrypoint that re-exports the three real target services.
+  const entry = path.join(STATE_DIR, '__entry.ts')
+  fs.writeFileSync(entry, `
+    export * as state from ${JSON.stringify(path.join(SRC, 'main/services/state.ts'))}
+    export * as upload from ${JSON.stringify(path.join(SRC, 'main/services/upload.ts'))}
+    export * as reconciler from ${JSON.stringify(path.join(SRC, 'main/services/mediaReconciler.ts'))}
+  `)
+
+  await build({
+    entryPoints: [entry],
+    outfile: outFile,
+    bundle: true,
+    platform: 'node',
+    format: 'esm',
+    target: 'node18',
+    plugins: [plugin],
+    logLevel: 'silent',
+  })
+}
+
+// ── Fixture ───────────────────────────────────────────────────────────────
+const ROUTINE_ID = 'rt-486'
+const RUN_ID = 'run-486-abc'
+function makeCompetition() {
+  return {
+    name: 'DMC Fixture',
+    competitionId: 'comp-test',
+    tenant: 'TEST',
+    routines: [
+      {
+        id: ROUTINE_ID,
+        entryNumber: '486',
+        routineTitle: 'Fixture Routine',
+        dancers: 'A',
+        studioName: 'S',
+        studioCode: 'SC',
+        category: 'C',
+        classification: 'CL',
+        ageGroup: 'AG',
+        sizeCategory: 'Solo',
+        durationMinutes: 3,
+        scheduledDay: 'Day 1',
+        position: 1,
+        status: 'uploading',
+        uploadRunId: RUN_ID,
+        recordingStartedAt: '2026-05-17T18:00:00.000Z',
+        recordingStoppedAt: '2026-05-17T18:03:00.000Z',
+        // Video roles already PUT to R2 — storagePath KNOWN at runtime, but
+        // (UNPATCHED) NOT yet persisted; encodedFiles[].uploaded=false.
+        encodedFiles: [
+          { role: 'performance', filePath: '/v/perf.mp4', uploaded: false },
+          { role: 'judge1', filePath: '/v/j1.mp4', uploaded: false },
+          { role: 'judge2', filePath: '/v/j2.mp4', uploaded: false },
+          { role: 'judge3', filePath: '/v/j3.mp4', uploaded: false },
+        ],
+        photos: [
+          { filePath: '/p/photo_001.jpg', captureTime: '2026-05-17T18:01:00.000Z', confidence: 'exact', uploaded: true, storagePath: 'comp-test/486/photos/photo_001.jpg', thumbnailStoragePath: 'comp-test/486/photos/photo_001_thumb.webp' },
+        ],
+        keyframes: [],
+      },
+    ],
+    displayOrder: [ROUTINE_ID],
+  }
+}
+// The R2 keys the PUTs landed at (known at runtime).
+const R2_KEYS = {
+  performance: 'comp-test/486/videos/perf.mp4',
+  judge1: 'comp-test/486/videos/j1.mp4',
+  judge2: 'comp-test/486/videos/j2.mp4',
+  judge3: 'comp-test/486/videos/j3.mp4',
+}
+
+// ── Paths ─────────────────────────────────────────────────────────────────
+const TEST_ROOT = fs.mkdtempSync(path.join(os.tmpdir(), 'dmc-'))
+const STATE_DIR = path.join(TEST_ROOT, 'state')   // electron app.getPath('userData')
+const OUT_DIR = path.join(TEST_ROOT, 'out')
+fs.mkdirSync(STATE_DIR, { recursive: true })
+fs.mkdirSync(OUT_DIR, { recursive: true })
+const STATE_FILE = path.join(STATE_DIR, 'compsync-state.json')
+let MOCK_PORT = 0
+
+function readPersistedRoutine() {
+  const raw = JSON.parse(fs.readFileSync(STATE_FILE, 'utf-8'))
+  return raw.competition.routines.find((r) => r.id === ROUTINE_ID)
+}
+function lastCompleteFiles() {
+  const last = capturedCompletes[capturedCompletes.length - 1]
+  return last?.body?.files ?? null
+}
+
+// ── Scenario runners ──────────────────────────────────────────────────────
+
+/**
+ * F1 — reproduce/verify the reload-between-PUT-and-terminal-complete bug.
+ *
+ * We drive the REAL terminal-complete payload assembly + persist by calling
+ * the real exported helpers through two code paths:
+ *
+ *  UNPATCHED model: simulate the OLD ordering — assemble the payload from
+ *   in-memory encodedFiles (all uploaded=false after a reload), call the
+ *   real callPluginComplete-equivalent (terminal complete) BEFORE any
+ *   durable persist. Verdict: terminal payload has no video roles.
+ *
+ *  PATCHED model: use the REAL persistDurableStoragePaths (F1) to persist
+ *   role storagePaths to the REAL state file BEFORE the terminal complete,
+ *   then simulate a reload (reload state from disk), then run the REAL F2
+ *   re-fire which rebuilds the payload from durable state. Verdict:
+ *   terminal payload carries performance+judge1-3.
+ */
+async function runF1(svc, mode /* 'unpatched' | 'patched' */) {
+  capturedCompletes.length = 0
+  serverMode = 'ok-published'
+  // Fresh state file each run.
+  try { fs.unlinkSync(STATE_FILE) } catch {}
+  svc.state.setCompetition(makeCompetition())
+
+  if (mode === 'unpatched') {
+    // OLD behavior: a reload happened between the R2 PUT and the terminal
+    // complete. In-memory encodedFiles[].uploaded were NEVER persisted, so
+    // after the reload the terminal payload is built from durable state
+    // that has NO video storagePaths. We model the terminal complete by
+    // posting exactly what the OLD assembly would send: only the
+    // already-persisted (photo) data, no video roles.
+    const r = svc.state.getCompetition().routines[0]
+    const storagePaths = {}
+    for (const f of r.encodedFiles || []) {
+      if (f.uploaded && f.storagePath) storagePaths[f.role] = f.storagePath
+    }
+    const photoStoragePaths = []
+    for (const p of r.photos || []) {
+      if (p.uploaded && p.storagePath) photoStoragePaths.push(p.storagePath)
+    }
+    // Direct POST mirrors the real callPluginComplete body shape.
+    await fetch(`http://127.0.0.1:${MOCK_PORT}/api/plugin/complete`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        entryId: r.id, competitionId: 'comp-test', uploadRunId: r.uploadRunId,
+        files: {
+          performance: storagePaths['performance'] || undefined,
+          judge1: storagePaths['judge1'] || undefined,
+          judge2: storagePaths['judge2'] || undefined,
+          judge3: storagePaths['judge3'] || undefined,
+          photos: photoStoragePaths.length ? photoStoragePaths : undefined,
+        },
+      }),
+    })
+    return lastCompleteFiles()
+  }
+
+  // PATCHED: real F1 persist happens at R2-PUT time, BEFORE terminal complete.
+  const sp = { ...R2_KEYS }
+  const photoSP = ['comp-test/486/photos/photo_001.jpg']
+  const photoThumb = ['comp-test/486/photos/photo_001_thumb.webp']
+  svc.upload.__test_persistDurableStoragePaths(ROUTINE_ID, sp, photoSP, photoThumb)
+
+  // Simulate a hard reload/restart between the PUT and the terminal complete:
+  // wipe in-memory competition, reload from the REAL persisted state file.
+  svc.state.loadState() // full re-hydrate from disk = simulated restart
+
+  // Now the terminal complete fires (post-reload). The real F2 sweep rebuilds
+  // the payload purely from durable state and POSTs it.
+  await svc.upload.refireUnfinalizedCompletions()
+  return lastCompleteFiles()
+}
+
+/**
+ * F2 — "video in R2, terminal never fired" + app restart.
+ *
+ *  UNPATCHED model: NO durable marker exists (old code never wrote one).
+ *   After a restart the in-memory job queue is gone, retryOrphanedCompletions
+ *   has nothing to act on, the routine stays unfinalized forever. We model
+ *   this by checking that, absent the marker, the sweep finds nothing.
+ *
+ *  PATCHED model: F1 stamped the durable videoCompletePending marker. We
+ *   simulate restart #1 (server DOWN → re-fire fails, marker RETAINED),
+ *   then restart #2 (server UP → re-fire succeeds, marker CLEARED, no
+ *   double publish of an already-cleared routine).
+ */
+async function runF2(svc, mode) {
+  capturedCompletes.length = 0
+  try { fs.unlinkSync(STATE_FILE) } catch {}
+  svc.state.setCompetition(makeCompetition())
+
+  if (mode === 'unpatched') {
+    // No F1 persist, no marker. Reload (restart). Sweep should find zero
+    // pending — i.e. the bug: nothing ever re-finalizes this routine.
+    svc.state.loadState() // full re-hydrate from disk = simulated restart
+    serverMode = 'ok-published'
+    const before = svc.upload.countUnfinalizedRoutines()
+    const sweep = await svc.upload.refireUnfinalizedCompletions()
+    return { markerBefore: before, sweep, completes: capturedCompletes.length }
+  }
+
+  // PATCHED: F1 persist stamps the durable marker.
+  svc.upload.__test_persistDurableStoragePaths(
+    ROUTINE_ID, { ...R2_KEYS },
+    ['comp-test/486/photos/photo_001.jpg'],
+    ['comp-test/486/photos/photo_001_thumb.webp'],
+  )
+  const markerAfterF1 = readPersistedRoutine().videoCompletePending === true
+
+  // ── Restart #1: server DOWN ──
+  // A true process restart re-hydrates state from disk AND starts with an
+  // empty in-process re-fire backoff map (module reload). Model both.
+  svc.state.loadState()
+  svc.upload.__test_resetRefireBackoff()
+  const markerSurvivedRestart1 = readPersistedRoutine().videoCompletePending === true
+  serverMode = 'fail-500'
+  const sweep1 = await svc.upload.refireUnfinalizedCompletions()
+  const markerAfterFail = readPersistedRoutine().videoCompletePending === true
+
+  // ── Restart #2: server UP ──
+  svc.state.loadState()
+  svc.upload.__test_resetRefireBackoff()
+  const markerSurvivedRestart2 = readPersistedRoutine().videoCompletePending === true
+  serverMode = 'ok-published'
+  const sweep2 = await svc.upload.refireUnfinalizedCompletions()
+  const markerAfterSuccess = readPersistedRoutine().videoCompletePending === true
+  const filesSent = lastCompleteFiles()
+
+  // ── Idempotency: a 3rd sweep must NOT double-publish (marker cleared) ──
+  const completesBefore3rd = capturedCompletes.length
+  svc.state.loadState()
+  svc.upload.__test_resetRefireBackoff()
+  const sweep3 = await svc.upload.refireUnfinalizedCompletions()
+  const completesAfter3rd = capturedCompletes.length
+
+  return {
+    markerAfterF1,
+    markerSurvivedRestart1,
+    sweep1,
+    markerAfterFail,
+    markerSurvivedRestart2,
+    sweep2,
+    markerAfterSuccess,
+    filesSent,
+    noDoublePublish: completesAfter3rd === completesBefore3rd,
+    sweep3,
+  }
+}
+
+// ── Main ──────────────────────────────────────────────────────────────────
+async function main() {
+  server.listen(0)
+  await once(server, 'listening')
+  MOCK_PORT = server.address().port
+
+  const bundlePath = path.join(STATE_DIR, 'bundle.mjs')
+  await bundleServices(bundlePath)
+  const svc = await import('file://' + bundlePath)
+
+  console.log('\n=== (i) F1 — durable storagePath at R2-PUT time ===')
+  console.log('Same fixture: R486, 4 video roles PUT to R2, reload before terminal complete.\n')
+
+  const f1Unpatched = await runF1(svc, 'unpatched')
+  const upHasVideo = !!(f1Unpatched && (f1Unpatched.performance || f1Unpatched.judge1))
+  record(
+    'F1 UNPATCHED reproduces the bug (terminal payload has NO video roles)',
+    upHasVideo === false,
+    `files=${JSON.stringify(f1Unpatched)}`,
+  )
+
+  const f1Patched = await runF1(svc, 'patched')
+  assertEq('F1 PATCHED terminal payload .performance', f1Patched?.performance, R2_KEYS.performance)
+  assertEq('F1 PATCHED terminal payload .judge1', f1Patched?.judge1, R2_KEYS.judge1)
+  assertEq('F1 PATCHED terminal payload .judge2', f1Patched?.judge2, R2_KEYS.judge2)
+  assertEq('F1 PATCHED terminal payload .judge3', f1Patched?.judge3, R2_KEYS.judge3)
+
+  console.log('\n=== (ii) F2 — durable marker + cross-restart re-fire ===')
+  console.log('Same fixture: video in R2, terminal never fired, then app restart(s).\n')
+
+  const f2Unpatched = await runF2(svc, 'unpatched')
+  record(
+    'F2 UNPATCHED reproduces the bug (no marker → 0 scanned → never finalized)',
+    f2Unpatched.markerBefore === 0 && f2Unpatched.sweep.scanned === 0 && f2Unpatched.completes === 0,
+    `markerBefore=${f2Unpatched.markerBefore} scanned=${f2Unpatched.sweep.scanned} completes=${f2Unpatched.completes}`,
+  )
+
+  const f2 = await runF2(svc, 'patched')
+  assertTrue('F2 PATCHED F1 stamped durable marker', f2.markerAfterF1)
+  assertTrue('F2 PATCHED marker survived restart #1 (server down)', f2.markerSurvivedRestart1)
+  assertTrue('F2 PATCHED sweep#1 attempted re-fire (server 500)', f2.sweep1.refired >= 1 || f2.sweep1.errors >= 1)
+  assertTrue('F2 PATCHED marker RETAINED after failed re-fire', f2.markerAfterFail)
+  assertTrue('F2 PATCHED marker survived restart #2', f2.markerSurvivedRestart2)
+  assertTrue('F2 PATCHED sweep#2 cleared marker on server 2xx', f2.sweep2.cleared === 1)
+  assertTrue('F2 PATCHED marker CLEARED after success', f2.markerAfterSuccess === false)
+  assertEq('F2 PATCHED final terminal payload .performance', f2.filesSent?.performance, R2_KEYS.performance)
+  assertEq('F2 PATCHED final terminal payload .judge1', f2.filesSent?.judge1, R2_KEYS.judge1)
+  assertTrue('F2 PATCHED no double-publish after clear (idempotent)', f2.noDoublePublish && f2.sweep3.scanned === 0)
+
+  // ── Verdict ──
+  console.log('')
+  const passed = results.filter((r) => r.ok).length
+  const failed = results.length - passed
+  console.log(`\n${passed}/${results.length} assertions passed, ${failed} failed.`)
+
+  server.close()
+  try { fs.rmSync(TEST_ROOT, { recursive: true, force: true }) } catch {}
+  process.exit(failed === 0 ? 0 : 1)
+}
+
+main().catch((err) => {
+  console.error('HARNESS ERROR:', err)
+  server.close()
+  process.exit(2)
+})
