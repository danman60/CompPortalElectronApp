+#!/usr/bin/env node
+/**
+ * Post-Cobourg queue/close-count — proof harness (B1 a/b/c)
+ *
+ * Mirrors tests/durable-media-completion/harness.mjs: the REAL target
+ * services
+ *   - src/main/services/jobQueue.ts
+ *   - src/main/services/upload.ts
+ *   - src/main/services/state.ts
+ * are esbuild-bundled with their real transitive deps. Only the OUTER
+ * boundary is shimmed (electron → tmp userData, logger → silent, events →
+ * no-op emitter, schedule → fixed test connection, settings → minimal,
+ * ipcUtil/recording/ffmpeg/photos/pipelineHealth/dayChecklist/importManifest
+ * → no-op). No business logic is mocked. The decisive verdict is read from
+ * the REAL persisted job-queue.json the REAL jobQueue.ts writes and the REAL
+ * compsync-state.json the REAL state.ts writes.
+ *
+ * Same fixture, opposite outcomes, primary-source verdict.
+ *
+ *   B1(a) — close-dialog count.
+ *     UNPATCHED model = the OLD close-dialog code: raw count of every
+ *       pending+failed+running upload record in job-queue.json — blind to
+ *       the durable F1/F2 oracle, folds in dupes + carcasses (reproduces the
+ *       inflated end-of-show number).
+ *     PATCHED = real getUndeliveredMediaSummary(): exactly the genuinely
+ *       undelivered distinct media (6); the 3 already-uploaded-per-durable
+ *       pending jobs and ALL terminal failed/quarantined excluded from the
+ *       headline (terminal surfaced separately, non-blocking).
+ *
+ *   B1(b) — enqueue dedupe (real upload.enqueueRoutine).
+ *     Same (routine,objectName) twice + an already-uploaded-per-durable file
+ *     → PATCHED creates NO duplicate; a force=true re-record STILL enqueues.
+ *
+ *   B1(c) — job-queue.json terminal hygiene (real jobQueue.pruneTerminal).
+ *     1500 terminal carcasses → pruned/bounded; pending/running/done
+ *     untouched; headline still the durable truth after prune.
+ *
+ * Run:  node tests/post-cobourg-queue/harness.mjs
+ */
+
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import crypto from 'node:crypto'
+import { fileURLToPath } from 'node:url'
+import { build } from 'esbuild'
+
+const __filename = fileURLToPath(import.meta.url)
+const __dirname = path.dirname(__filename)
+const REPO_ROOT = path.resolve(__dirname, '..', '..')
+const SRC = path.join(REPO_ROOT, 'src')
+
+// ── Test harness primitives ───────────────────────────────────────────────
+const results = []
+function record(name, ok, detail = '') {
+  results.push({ name, ok, detail })
+  console.log(`  [${ok ? 'PASS' : 'FAIL'}] ${name}${detail ? ' — ' + detail : ''}`)
+}
+function assertEq(name, actual, expected) {
+  const ok = JSON.stringify(actual) === JSON.stringify(expected)
+  record(name, ok, ok ? `= ${JSON.stringify(actual)}` : `expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`)
+  return ok
+}
+function assertTrue(name, cond, detail = '') {
+  record(name, !!cond, detail)
+  return !!cond
+}
+
+// ── Paths ─────────────────────────────────────────────────────────────────
+const TEST_ROOT = fs.mkdtempSync(path.join(os.tmpdir(), 'pcq-'))
+const STATE_DIR = path.join(TEST_ROOT, 'state') // electron app.getPath('userData')
+const OUT_DIR = path.join(TEST_ROOT, 'out')
+fs.mkdirSync(STATE_DIR, { recursive: true })
+fs.mkdirSync(OUT_DIR, { recursive: true })
+const STATE_FILE = path.join(STATE_DIR, 'compsync-state.json')
+const QUEUE_FILE = path.join(STATE_DIR, 'job-queue.json')
+
+// ── esbuild: bundle real modules, shim only the outer boundary ────────────
