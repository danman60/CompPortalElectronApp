+// ── F2: cross-restart re-fire of unfinalized terminal completes ───────────
+//
+// In-memory exponential backoff per routine so a persistently-failing
+// /complete (e.g. CompPortal down) doesn't hammer the endpoint every sweep.
+// Resets when the marker clears (success). Survives only for the process
+// lifetime — the durable videoCompletePending marker is the cross-restart
+// state; backoff is just rate-limiting within one run.
+interface RefireBackoff { failCount: number; nextAttemptAt: number }
+const refireBackoff = new Map<string, RefireBackoff>()
+const REFIRE_BACKOFF_BASE_MS = 60 * 1000        // 1 min
+const REFIRE_BACKOFF_CAP_MS = 30 * 60 * 1000    // 30 min
+
+function refireOnFailure(routineId: string): void {
+  const prev = refireBackoff.get(routineId)
+  const failCount = (prev?.failCount ?? 0) + 1
+  const delay = Math.min(REFIRE_BACKOFF_BASE_MS * Math.pow(2, failCount - 1), REFIRE_BACKOFF_CAP_MS)
+  refireBackoff.set(routineId, { failCount, nextAttemptAt: Date.now() + delay })
+}
+function refireIsBackedOff(routineId: string): boolean {
+  const b = refireBackoff.get(routineId)
+  return b != null && b.nextAttemptAt > Date.now()
+}
+
