+ * fills empty storagePath; never clears a path or downgrades a flag.
+ *
+ * F2 — when any *video role* (performance/judge1-4) now has a storage path,
+ * stamp `videoCompletePending=true` so a reload/restart before the terminal
+ * complete is acknowledged can re-fire it from durable state. Marker is left
+ * untouched here when no video role is present (photo-only routines never
+ * carry the marker — nothing to re-finalize on the video axis).
+ */
+function persistDurableStoragePaths(
+  routineId: string,
+  storagePaths: Record<string, string>,
+  photoStoragePaths: string[],
+  photoThumbnailStoragePaths: string[],
+): void {
+  const routine = state.getCompetition()?.routines.find((r) => r.id === routineId)
+  if (!routine) return
+
+  const updatedFiles = (routine.encodedFiles || []).map((f) => {
+    const sp = storagePaths[f.role]
+    if (!sp) return f
+    if (f.uploaded && f.storagePath === sp) return f
+    return { ...f, uploaded: true, storagePath: sp }
+  })
+
+  // Photos: match by index against the freshly-built parallel arrays. Only
+  // upgrade (false→true / fill empty path); never wipe an existing path.
+  const updatedPhotos = (routine.photos || []).map((p, i) => {
+    const sp = photoStoragePaths[i]
+    if (!sp) return p
+    const tsp = photoThumbnailStoragePaths[i]
+    const nextThumb = tsp && tsp.length > 0 ? tsp : p.thumbnailStoragePath
+    if (p.uploaded && p.storagePath === sp && p.thumbnailStoragePath === nextThumb) return p
+    return { ...p, uploaded: true, storagePath: sp, thumbnailStoragePath: nextThumb }
+  })
+
+  const VIDEO_ROLES = ['performance', 'judge1', 'judge2', 'judge3', 'judge4']
+  const hasVideoRolePath = VIDEO_ROLES.some((r) => !!storagePaths[r])
+
