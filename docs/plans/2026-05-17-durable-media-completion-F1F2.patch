+      }
+      logger.upload.info(`F2 re-fire: routine ${routine.id.slice(0, 8)} terminal complete re-sent from durable state`)
+    } catch (err) {
+      out.errors++
+      refireOnFailure(routine.id)
+      logger.upload.warn(
+        `F2 re-fire failed for routine ${routine.id.slice(0, 8)} (marker retained, will retry next sweep):`,
+        err instanceof Error ? err.message : err,
+      )
+    }
+  }
+
+  if (out.refired > 0 || out.cleared > 0) {
+    logger.upload.info(
+      `F2 re-fire sweep: scanned=${out.scanned} refired=${out.refired} cleared=${out.cleared} skipped=${out.skipped} errors=${out.errors}`,
+    )
+  }
+  return out
+}
